\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Band gap versus dielectric constant for potential high-k gate dielectrics.\relax }}{4}
\contentsline {figure}{\numberline {1.2}{\ignorespaces Measured band offsets of oxides on Si against dielectric constant for candidate gate oxides. Group III oxides are shown in red, HfO$_{2}$ and ZrO$_{2}$ in blue. From Reference \cite {Robertson2008}.\relax }}{5}
\contentsline {figure}{\numberline {1.3}{\ignorespaces The variation in dielectric constant (black squares) and dissipation factor (tan d, blue triangles) of Ta$_{x}$Ge$_{1-x}$O$_{y}$ as a function Ta cation fraction measured at 10 kHz. The dotted line represents the linear interpolation between endmember values. The uncertainty in $\varepsilon _{r}$ is estimated to be $\pm $ 5$\%$, dominated by uncertainty in the ellipsometrically determined thickness. From Reference \cite {Naoi2012}.\relax }}{9}
\contentsline {figure}{\numberline {1.4}{\ignorespaces Top down view inside the sputtering chamber that is used in this work. Three magnetron sputtering guns are in the 90 degree off-axis configuration with respect to the substrate. Sputtering in this configuration results in a natural thickness gradient across the substrate. Guns A, B, and C can be simultaneously be energized to create a composition spread.\relax }}{13}
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces (a) Parallel plate capacitor in a vacuum connected to a battery with voltage V and capacitance C$_{o}$ (b) The capacitance changes from C$_{o}$ to C when an insulating material is placed between the terminals. \relax }}{16}
\contentsline {figure}{\numberline {2.2}{\ignorespaces The contribution of the fringing field to the total electric field changes with the aspect ratio of the capacitor. Thin film capacitors have a large aspect ratio so the contribution of the fringing field is minimal.\relax }}{17}
\contentsline {figure}{\numberline {2.3}{\ignorespaces Application of an external electric field causes the atoms in the material to polarize along the direction of the applied field. Consequently, a surface polarization charge $Q_{p}$ forms at the interface between the electrode and the dielectric.\relax }}{19}
\contentsline {figure}{\numberline {2.4}{\ignorespaces To calculate the local field felt by the atom inside the material we create a hypothetical cavity in the material, creating a uniformly polarized sphere. The local field is determined by summing all the contributions to the local field.\relax }}{21}
\contentsline {figure}{\numberline {2.5}{\ignorespaces Dispersion relation of polarizability as a function of frequency. Figure taken from reference \cite {Subhadra2011}.\relax }}{23}
\contentsline {figure}{\numberline {2.6}{\ignorespaces Complex impedance.\relax }}{27}
\contentsline {figure}{\numberline {2.7}{\ignorespaces Off-axis configuration of the guns enable combinatorial studies of thin film amorphous oxides. Up to three sputtering guns can be simultaneously energized to form a ternary composition. RF biases ares applied to the substrate to form a dense film.\relax }}{31}
\contentsline {figure}{\numberline {2.8}{\ignorespaces Guns in the off-axis configuration for deposition rate calibration. Figure depicts a deposition profile along Gun A.\relax }}{36}
\contentsline {figure}{\numberline {2.9}{\ignorespaces Cartoon showing the different silicon nitride membrane arrays used for the diffraction studies. From left to right: 8$\times $8, 9$\times $9, and 12$\times $12 arrays.\relax }}{43}
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Composition as a function of position along the 7-cm sample axis. Solid line: compositions calculated using rate calibrations for each species (\ce {ZrO2}, \ce {Al2O3}). Squares: Compositions inferred using Rutherford Backscattering Spectroscopy. Inset: a typical RBS spectrum used to determine the composition. A small level of Ar incorporation is typical in sputtered films, and can be seen in the RBS spectrum, though it has a negligible effect on electrical or structural properties.\relax }}{52}
\contentsline {figure}{\numberline {3.2}{\ignorespaces X-ray diffraction patterns for typical nanocrystalline Zr-rich samples. Top curve: $Zr_{0.75}Si_{0.25}O_2$ film as deposited, offset vertically for clarity, with positions for the strongest monoclinic reflections indicated. Bottom curve: $Zr_{0.89}Al_{0.11}O_{1.94}$, illustrating x-ray peaks that are broader due to the lower degree of crystallinity compared to the Zr-Si-O sample.\relax }}{54}
\contentsline {figure}{\numberline {3.3}{\ignorespaces Bottom: Composition dependence of the dielectric constant of thin film $\textnormal {Zr}_{1-x}\textnormal {Al}_{x}\textnormal {O}_{1.5+x/2}$ deposited at room temperature. Dotted lines represent extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {Al2O3}) indicated with triangles.Top: composition dependence of the structural coherence length (i.e., essentially grain size) as inferred from X-ray diffraction data using the Debye-Scherrer formula. \relax }}{57}
\contentsline {figure}{\numberline {3.4}{\ignorespaces Bottom: Composition dependence of the dielectric constant of thin film $\textnormal {Zr}_{1-x}\textnormal {Si}_{x}\textnormal {O}_{2}$ deposited at room temperature. Dotted lines represent extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {SiO2}) indicated with triangles.Top: composition dependence of the structural coherence length (i.e., essentially grain size) as inferred from X-ray diffraction data using the Debye-Scherrer formula.\relax }}{58}
\contentsline {figure}{\numberline {3.5}{\ignorespaces Bottom: Composition dependence of the refractive index $n_0$ of thin film $\textnormal {Zr}_{1-x}\textnormal {Al}_{x}\textnormal {O}_{2-x/2}$ and $\textnormal {Zr}_{x}\textnormal {Si}_{1-x}\textnormal {O}_{2}$ deposited at room temperature. Dotted lines represent extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {SiO2} and \ce {Al2O3}) indicated with triangles.\relax }}{59}
\contentsline {figure}{\numberline {3.6}{\ignorespaces Composition dependence of the polarizability per unit volume, $\alpha /V$. Dotted lines are extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {SiO2}) indicated with triangles. Top curve: polarizability inferred from the static (10 kHz) dielectric constant. Bottom curve: polarizability inferred from the optical index of refraction. The solid line is a simple interpolation between the values for the endmembers.\relax }}{62}
\contentsline {figure}{\numberline {3.7}{\ignorespaces Composition dependence of the polarizability per unit volume, $\alpha /V$. Dotted lines are extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {Al2O3}) indicated with triangles. Top curve: polarizability inferred from the static (10 kHz) dielectric constant. Bottom curve: polarizability inferred from the optical index of refraction. The solid line is a simple interpolation between the values for the endmembers.\relax }}{63}
\contentsline {figure}{\numberline {3.8}{\ignorespaces Composition dependence of the ionic polarizability,, as inferred from the text. Dotted lines represent extrapolations to values for the endmembers (crystalline and amorphous \ce {ZrO2} and amorphous \ce {SiO2} and \ce {Al2O3}) indicated with triangles.\relax }}{65}
\contentsline {figure}{\numberline {3.9}{\ignorespaces Composition dependence of the breakdown field in Zr-Si-O and Zr-Al-O. Solid symbols represent Zr-Al-O capacitors and open circles represent Zr-Si-O capacitors. Notice that no change in the trend is associated with the crystalline/amorphous transition at $x \approx 0.35$.\relax }}{66}
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces The XRD spectra for (a) (HfO$_{2}$)$_{1-x}$(SiO$_{2}$)$_{x}$ and (b) (HfO$_{2}$)$_{1-x}$(GeO$_{2}$)$_{x}$ plotted for several different Hf cation compositions. The observed patterns between Si and Ge doped HfO$_{2}$ are highly similar, demonstrating their chemical resemblance. The diffraction pattern for the mixed films show that the monoclinic phase is the dominant phase, however comparison with available diffraction patterns suggest the presence of other metastable phases. For reference the diffraction pattern of pure HfO$_{2}$ is shown at the bottom. The weak reflections reveal the presence of partially crystalline domains.\relax }}{73}
\contentsline {figure}{\numberline {4.2}{\ignorespaces The dielectric constant and dissipation factor of (a) (HfO$_{2}$)$_{1-x}$(SiO$_{2}$)$_{x}$ and (b) (HfO$_{2}$)$_{1-x}$(GeO$_{2}$)$_{x}$ as function of Hf cation composition. In contrast to the XRD patterns in Figure 4.1\hbox {}, the dielectric behavior of the two materials are different.\relax }}{75}
\contentsline {figure}{\numberline {4.3}{\ignorespaces The density of (a) (HfO$_{2}$)$_{1-x}$(SiO$_{2}$)$_{x}$ and (b) (HfO$_{2}$)$_{1-x}$(GeO$_{2}$)$_{x}$ as function of Hf cation composition determined using XRR. Crystallization of the film causes the film density to jump dramatically.\relax }}{77}
\contentsline {figure}{\numberline {4.4}{\ignorespaces Refractive index of (a) (HfO$_{2}$)$_{1-x}$(SiO$_{2}$)$_{x}$ and (b) (HfO$_{2}$)$_{1-x}$(GeO$_{2}$)$_{x}$ as function of Hf cation composition.\relax }}{78}
\contentsline {figure}{\numberline {4.5}{\ignorespaces XRD spectra for (a) (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ and (b) (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ plotted for several cation compositions. The lack of any discernible diffraction peaks indicate that the (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ is x-ray amorphous for the entire composition range probed. (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ is x-ray amorphous for high Ta$_{2}$O$_{5}$ rich composition, but crystallizes at high SnO$_{2}$ concentrations.\relax }}{79}
\contentsline {figure}{\numberline {4.6}{\ignorespaces The dielectric constant and dissipation factor for (a) (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ and (b) (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ plotted as a function of composition. The dielectric constant of (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ shows a mostly linear dependence in $\varepsilon _{r}$ with composition, whereas (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ shows a nondispersive and highly dispersive region.\relax }}{80}
\contentsline {figure}{\numberline {4.7}{\ignorespaces Refractive index of (a) (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ and (b) (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ as function of Hf cation composition.\relax }}{82}
\contentsline {figure}{\numberline {4.8}{\ignorespaces The density of (a) (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ and (b) (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ as function of Hf cation composition determined using XRR. The linear variation in density for (Nb$_{2}$O$_{5}$)$_{1-x}$(GeO$_{2}$)$_{x}$ as a function of composition reflects the amorphous nature of for all composition. (Ta$_{2}$O$_{5}$)$_{1-x}$(SnO$_{2}$)$_{x}$ densities also vary linearly except for the point where the film crystallizes.\relax }}{83}
\addvspace {10\p@ }
